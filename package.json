{
  "name": "appdimens-react-native",
  "version": "3.2.0",
  "description": "AppDimens Dynamic for React Native — responsive dp/sp scaling (sdp, hdp, wdp, ssp…) with 12 strategies, resize and physical units. Same API names as the Android library, pure JS, O(1) per call.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": [
    "./src/number.ts",
    "./src/strategies/*/number.ts",
    "./lib/commonjs/number.js",
    "./lib/module/number.js",
    "./lib/commonjs/strategies/*/number.js",
    "./lib/module/strategies/*/number.js"
  ],
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./number": {
      "types": "./lib/typescript/number.d.ts",
      "react-native": "./src/number.ts",
      "import": "./lib/module/number.js",
      "require": "./lib/commonjs/number.js",
      "default": "./lib/commonjs/number.js"
    },
    "./resize": {
      "types": "./lib/typescript/resize/index.d.ts",
      "react-native": "./src/resize/index.ts",
      "import": "./lib/module/resize/index.js",
      "require": "./lib/commonjs/resize/index.js",
      "default": "./lib/commonjs/resize/index.js"
    },
    "./units": {
      "types": "./lib/typescript/units/index.d.ts",
      "react-native": "./src/units/index.ts",
      "import": "./lib/module/units/index.js",
      "require": "./lib/commonjs/units/index.js",
      "default": "./lib/commonjs/units/index.js"
    },
    "./*/number": {
      "types": "./lib/typescript/strategies/*/number.d.ts",
      "react-native": "./src/strategies/*/number.ts",
      "import": "./lib/module/strategies/*/number.js",
      "require": "./lib/commonjs/strategies/*/number.js",
      "default": "./lib/commonjs/strategies/*/number.js"
    },
    "./*": {
      "types": "./lib/typescript/strategies/*/index.d.ts",
      "react-native": "./src/strategies/*/index.ts",
      "import": "./lib/module/strategies/*/index.js",
      "require": "./lib/commonjs/strategies/*/index.js",
      "default": "./lib/commonjs/strategies/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "auto",
    "density",
    "diagonal",
    "fill",
    "fit",
    "fluid",
    "interpolated",
    "logarithmic",
    "percent",
    "perimeter",
    "power",
    "resize",
    "units",
    "number",
    "!lib/**/*.map",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "generate": "node scripts/generate.js",
    "generate:check": "node scripts/generate.js --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"example/**/*.tsx\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"__mocks__/**/*.ts\" \"example/**/*.tsx\" \"scripts/**/*.{js,mjs,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"__mocks__/**/*.ts\" \"example/**/*.tsx\" \"scripts/**/*.{js,mjs,cjs}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "bench": "node scripts/bench.js",
    "build": "bob build && node scripts/postbuild.js",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "validate": "npm run generate:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "react-native",
    "responsive",
    "dimensions",
    "scaling",
    "sdp",
    "ssp",
    "dp",
    "sp",
    "tablet",
    "foldable",
    "expo",
    "appdimens",
    "appdimens-dynamic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bodenberg/appdimens-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/bodenberg/appdimens-react-native/issues"
  },
  "homepage": "https://github.com/bodenberg/appdimens-react-native#readme",
  "author": {
    "name": "Jean Bodenberg",
    "email": "jc8752719@gmail.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.12",
    "@types/react-test-renderer": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "jest": "29.7.0",
    "prettier": "3.3.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-builder-bob": "0.30.3",
    "react-test-renderer": "18.3.1",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.64.0"
  },
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
